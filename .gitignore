# ==============================================================================
# Aircon Service Pro — Production Git Ignore
# ==============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js & Build Artifacts
/.next/
/out/
/build
/dist
.vercel
next-env.d.ts
*.tsbuildinfo

# Environment & Secrets (CRITICAL)
.env
.env.*
!.env.example

# Database & Prisma Local Files
*.db
*.db-journal
*.sqlite
*.sqlite3
/prisma/*.db

# AI Agent Skills & IDE Directories (Prevent bloat & submodule conflicts)
.agent/
.agents/
.impeccable/
.cursor/
.claude/
.windsurf/
.codex/
.devin/
.gemini/
.idea/
.vscode/
*.swp
*.swo

# Logs & OS Junk
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
Thumbs.db
*.pem

# Testing & Coverage
/coverage
/.nyc_output
