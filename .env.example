# ==============================================================================
# Aircon Service Pro — Environment Variables Template
# Copy this file to .env.local for local development. Never commit .env files.
# ==============================================================================

# Database Connection (PostgreSQL / Supabase / Neon or SQLite for local dev)
DATABASE_URL="postgresql://postgres:password@localhost:5432/aircon_service_pro?schema=public"

# NextAuth.js Authentication (Phase 2 Staff & Technician Portal)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-generate-32-byte-secret-key-here"

# LINE Messaging API & Dispatch Webhooks (Phase 2 Customer & Team Notifications)
LINE_CHANNEL_ACCESS_TOKEN="your_line_channel_access_token_here"
LINE_CHANNEL_SECRET="your_line_channel_secret_here"
LINE_GROUP_ID="your_line_technician_dispatch_group_id_here"

